// @see - https://www.electron.build/configuration/configuration
{
  "appId": "com.adventtools.adventshow",
  "asar": true,
  "asarUnpack": [
    "**/node_modules/ffmpeg-static/**",
    "**/node_modules/better-sqlite3/**"
  ],
  "productName": "AdventShow",
  "icon": "build/icon.png",
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "extraResources": [
    {
      "from": "public/hymns.db",
      "to": "hymns.db",
      "filter": ["**/*"]
    },
    {
      // șabloane standard de prezentare (Realtime) — copiate la pornire în
      // userData/templates doar dacă lipsesc; cele custom nu sunt atinse
      "from": "templates",
      "to": "templates",
      "filter": ["**/*.json"]
    },
    {
      "from": "scripts/cornilescu.json",
      "to": "cornilescu.json",
      "filter": ["**/*"]
    },
    {
      "from": "electron/certs/adventshow.crt",
      "to": "adventshow.crt",
      "filter": ["**/*"]
    }
  ],
  "afterPack": "./scripts/afterPack.cjs",
  // electron-updater reads release metadata (latest.yml / latest-mac.yml) from
  // hangar.it4all.ro. Declaring `publish` is what writes the feed URL into
  // app-update.yml inside the installer; it does NOT auto-publish — our build
  // scripts run electron-builder without `--publish`, and release.sh uploads the
  // artifacts through the hub API.
  //
  // The yml files electron-builder generates next to the artifacts are NOT uploaded:
  // hangar builds the feeds from its own database at every promotion, so an uploaded
  // one would be ignored. The `channel` here only names the default feed; the app
  // switches to beta.yml at runtime (autoUpdater.channel).
  //
  // The path segment is a public key, not a secret — it ships inside every installer.
  "publish": {
    "provider": "generic",
    "url": "https://hangar.it4all.ro/d/ba3166b608233a30/",
    "channel": "latest"
  },
  "mac": {
    "icon": "build/icons/mac/icon.icns",
    // Default: auto-discovery din keychain (semnează dacă găsește Developer ID).
    // Dev unsigned: pornește cu `CSC_IDENTITY_AUTO_DISCOVERY=false` (vezi build-mac.sh).
    // Release signed: pornește cu `CSC_NAME="$MACOS_SIGNING_IDENTITY"` (vezi build-mac.sh).
    // NU setăm `identity: null` aici — declanșează un cod path în electron-builder care
    // semnează main exe dar SARE Electron Framework, ceea ce face notarizarea Apple să eșueze
    // cu "code object is not signed at all" pe framework.
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "notarize": false,
    // dmg = first-time install (drag to Applications). zip = what Squirrel.Mac
    // (electron-updater) downloads to self-apply updates in place. Both are signed
    // + notarized; latest-mac.yml references the zip.
    "target": [
      "dmg",
      "zip"
    ],
    "artifactName": "AdventShow-Mac-${version}.${ext}"
  },
  "dmg": {
    // Fereastra DMG cu instrucțiuni vizuale: fundalul (generat de
    // scripts/create_dmg_background.py) pictează titlul + săgeata, iar Finder
    // desenează iconițele pe pozițiile de mai jos (centrele lor).
    "background": "build/dmg-background.png",
    "window": {
      "width": 540,
      "height": 380
    },
    "iconSize": 128,
    "contents": [
      {
        "x": 140,
        "y": 230,
        "type": "file"
      },
      {
        "x": 400,
        "y": 230,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "win": {
    "icon": "build/icons/win/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    // Versiunea TREBUIE să fie în nume: electron-updater deduce numele fișierului
    // vechi înlocuind versiunea, iar hangar publică fiecare versiune în același
    // director plat — două release-uri cu „AdventShow-Setup.exe" s-ar suprascrie.
    "artifactName": "AdventShow-Setup-${version}.${ext}",
    "sign": "./scripts/sign-windows.cjs",
    "signingHashAlgorithms": ["sha256"]
  },
  "nsis": {
    // One-click installer: a single progress screen, no wizard. This is what makes
    // auto-update seamless — electron-updater runs it silently, it closes the running
    // app, installs, and relaunches automatically (no cmd window, no manual steps).
    "oneClick": true,
    // Per-user install in %LOCALAPPDATA% — NO UAC prompt, fully silent. This is what
    // makes auto-update completely hands-off: electron-updater runs the installer
    // silently, it closes the running app, installs, and relaunches — zero clicks,
    // no admin prompt, no cmd window. (perMachine:true would force a UAC prompt on
    // every update, which is the manual step we are eliminating.)
    "perMachine": false,
    "deleteAppDataOnUninstall": false,
    // "always" — recrează shortcut-ul de desktop la FIECARE instalare/update. Cu
    // `true`, NSIS nu mai recreează un shortcut pe care îl consideră șters de user;
    // după un update eșuat care a șters iconița, instalările următoare o lăsau lipsă.
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "AdventShow",
    "include": "build/installer.nsh"
  },
  "linux": {
    "icon": "build/icons/png",
    "target": [
      "AppImage"
    ],
    "artifactName": "AdventShow-Linux-${version}.${ext}"
  }
}

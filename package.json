{
  "name": "adventshow",
  "private": true,
  "version": "1.6.13",
  "productName": "AdventShow",
  "description": "Aplicatie gratuita pentru proiectia imnurilor si versetelor biblice in biserica.",
  "author": "AdventTools",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dist": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "mac:dev": "./scripts/build-mac.sh dev",
    "mac:signed": "./scripts/build-mac.sh release",
    "win:dev": "./scripts/build-win.sh dev",
    "win:signed": "./scripts/build-win.sh release",
    "release:signed": "./scripts/release.sh",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "mirror:corrections": "curl -sfL https://hangar.it4all.ro/d/ba3166b608233a30/corrections.json -o content/corrections.json && echo 'corecturi oglindite din hangar in content/corrections.json'",
    "sync:seed": "ELECTRON_RUN_AS_NODE=1 electron scripts/sync-seed-from-hangar.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cfb": "^1.2.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "daisyui": "5.5.18",
    "electron": "^43.8.3",
    "electron-builder": "^26.15.3",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lucide-react": "^1.55.0",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "main": "dist-electron/main.js"
}

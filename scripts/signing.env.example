# ═══════════════════════════════════════════════════════════════════════════════
# AdventShow — Configurație de semnare
# ═══════════════════════════════════════════════════════════════════════════════
# Copiază acest fișier în `signing.env` (gitignored) și completează valorile.
# Folosit de scripts/build-mac.sh, build-win.sh, release.sh.
#
# IMPORTANT: NU comite `signing.env` completat. `.gitignore` blochează fișierul.
# ═══════════════════════════════════════════════════════════════════════════════

# ── macOS — Developer ID + notarytool ────────────────────────────────────────
# Identitatea exactă din keychain. Rulează:
#   security find-identity -v -p codesigning
# și copiază textul dintre ghilimele (ex: "Developer ID Application: Nume (TEAMID)").
export MACOS_SIGNING_IDENTITY="Developer ID Application: NUME (TEAMID)"

# Apple ID + Team ID
export APPLE_ID="email@example.com"
export APPLE_TEAM_ID="XXXXXXXXXX"

# Profilul keychain pentru notarytool. Creat o singură dată cu:
#   xcrun notarytool store-credentials "<NUME_PROFIL>" \
#       --apple-id "$APPLE_ID" --team-id "$APPLE_TEAM_ID" \
#       --password "<app-specific-password-de-la-appleid.apple.com>"
# Parolă app-specific: appleid.apple.com → Sign-In and Security → App-Specific Passwords.
export NOTARY_PROFILE="my-notary-profile"

# ── Windows — Azure Trusted Signing (semnare pe VM remote) ───────────────────
# Mașina Windows de build (accesată prin ProxyJump=jumper, configurat în ~/.ssh/config)
export WIN_HOST="user@192.168.x.x"
export WIN_SSH_PORT="22"
export WIN_REPO="C:\\AdventShow-Git"

# Semnarea efectivă pe VM folosește Azure Trusted Signing prin signtool /dlib.
# Configurarea (ts-metadata.json, Azure.CodeSigning.Dlib.dll, sesiune az login)
# se face pe VM, NU aici. Vezi documentația separată Azure TS.
